# CircuitTutor configuration template
#
# Copy this file to ".env" (same folder as run.cmd) and edit the
# values you need. Every key is optional: delete a line, or keep the
# file unchanged, to fall back to the default.
#
# Only simple KEY=VALUE lines are read, one per line, no quotes.
# ".env" is ignored by git, so your local paths stay private.


# Port the app listens on. The web UI and the API share this port.
# Default: 8000
CT_PORT=8000


# Full path to python.exe. Leave empty to auto-detect Python 3.10+.
# Set this when Python is installed but not on PATH, or when several
# versions exist and you want a specific one.
# Example: CT_PYTHON=C:\Python312\python.exe
CT_PYTHON=


# pip index URL used when installing backend dependencies.
# Default: Tsinghua mirror (fast inside mainland China).
# Leave the value empty to use the official PyPI instead.
# Other mirrors: https://mirrors.aliyun.com/pypi/simple/
#                https://mirrors.ustc.edu.cn/pypi/simple/
CT_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple